{
  "name": "yielded-auth-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent --hooks-dir .vite-hooks",
    "patch:tsgo": "effect-tsgo patch --typescript",
    "changeset": "bun x changeset",
    "changeset:version": "bun x changeset version",
    "ci:version": "bun x changeset version && bun install",
    "check": "vp check && vp run -r --concurrency-limit 1 check && vp run check:scripts && vp run check:exports && vp run verify:package-purity",
    "check:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "check:exports": "bun scripts/verify-package-exports.ts",
    "verify:package-purity": "bun scripts/verify-package-purity.ts",
    "check:package-consumers": "bun scripts/verify-package-consumers.ts",
    "test": "vp run -r --parallel --concurrency-limit 4 test",
    "build": "vp run -r build && vp run check:package-consumers && vp run docs:build",
    "ready": "vp run check && vp run test && vp run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "release:checked-publish": "vp run --no-cache release:publish --check-ready"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.0",
    "@effect/atom-react": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@fontsource-variable/ibm-plex-sans": "catalog:",
    "@fontsource/ibm-plex-mono": "catalog:",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@yielded/auth": "workspace:*",
    "@yielded/auth-persistence": "workspace:*",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "effect-cf": "catalog:",
    "esbuild": "catalog:",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "typescript-twoslash": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
